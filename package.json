{
  "name": "portfolio-2026",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "ui:check": "node scripts/ui-check.mjs",
    "ui:check:baseline": "node scripts/ui-check.mjs --write-baseline",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "check": "pnpm lint && pnpm validate:content && pnpm typecheck && pnpm build && pnpm validate:html",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "24.2.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.2"
  }
}
